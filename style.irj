mod uzor.style

use std.term {csi}

;; Colours, attributes and display width — everything needed to turn a
;; run of text into bytes a terminal understands. No effects here: a
;; style is a value, `sgr` is a pure Str, and width is computed from
;; code points. That keeps the whole rendering path testable without a
;; terminal.

;; ── Colours ─────────────────────────────────────────────────────────
;;
;; A colour is an Int: -1 is the terminal's own default, 0..255 index
;; the xterm palette (0-7 basic, 8-15 bright, 16-231 the 6x6x6 cube,
;; 232-255 the grey ramp). The palette is used rather than truecolour
;; because it degrades gracefully — a 256-colour escape renders
;; somewhere sane on everything from tmux to a bare Linux console,
;; while a truecolour one can come out as noise.

pub color-default := -1

pub black := 0
pub red := 1
pub green := 2
pub yellow := 3
pub blue := 4
pub magenta := 5
pub cyan := 6
pub white := 7
pub bright-black := 8
pub bright-red := 9
pub bright-green := 10
pub bright-yellow := 11
pub bright-blue := 12
pub bright-magenta := 13
pub bright-cyan := 14
pub bright-white := 15

;; Grey ramp entry, 0 (near-black) .. 23 (near-white).
pub fn grey :: Int Int
  => n
  232 + (max 0 (min 23 n))

;; 6x6x6 colour cube; each component 0..5.
pub fn rgb6 :: Int Int Int Int
  => r g b
  16 + (36 * (clamp5 r)) + (6 * (clamp5 g)) + (clamp5 b)

fn clamp5 :: Int Int
  => n
  max 0 (min 5 n)

;; ── Styles ──────────────────────────────────────────────────────────

pub spec Style
  fg :: Int
  bg :: Int
  bold :: Bool
  dim :: Bool
  italic :: Bool
  underline :: Bool
  reverse :: Bool

;; `style {fg= red bold= true}` — anything left out comes from the
;; defaults below, so a caller never spells out all seven fields. This
;; is also the only place those defaults are written down.
pub fn style :: Map Style
  => o
  Style (field-or o "fg" (-1)) (field-or o "bg" (-1)) (field-or o "bold" false) (field-or o "dim" false) (field-or o "italic" false) (field-or o "underline" false) (field-or o "reverse" false)

fn field-or :: Map Str _ _
  => m k dflt
  if (contains? m k)
    get k m
  else
    dflt

;; The identity style — default colours, no attributes.
pub plain := style {}

;; Field updates go through the constructor: record-update syntax
;; (`{...st fg= c}`) is Map-only, and a Style is a spec value.
pub fn with-fg :: Style Int Style
  => st c
  Style c st.bg st.bold st.dim st.italic st.underline st.reverse

pub fn with-bg :: Style Int Style
  => st c
  Style st.fg c st.bold st.dim st.italic st.underline st.reverse

;; ── SGR ─────────────────────────────────────────────────────────────

;; `sgr st` — the Select Graphic Rendition sequence that puts a
;; terminal into this style.
;;
;; Every sequence starts with a reset (`0`). Emitting the full state
;; per span costs a handful of bytes and removes a whole class of bug:
;; a differential encoder has to know what the terminal is already
;; showing, and any drift (a resize, a stray write, a redrawn region)
;; leaves colour smeared across the screen.
pub fn sgr :: Style Str
  => st
  csi ((join ";" (sgr-params st)) ++ "m")

fn sgr-params :: Style Vec
  => st
  add-colors st (attr-params st)

;; Spelled out rather than folded over a table of field names: fields
;; of a spec value are reached by `.name`, which is static, so a
;; name-driven loop would need the Map representation back.
fn attr-params :: Style Vec
  => st
  a1 := flag-param #["0"] st.bold "1"
  a2 := flag-param a1 st.dim "2"
  a3 := flag-param a2 st.italic "3"
  a4 := flag-param a3 st.underline "4"
  flag-param a4 st.reverse "7"

fn flag-param :: Vec Bool Str Vec
  => params on param
  if on
    conj params param
  else
    params

fn add-colors :: Style Vec Vec
  => st params
  add-color (add-color params st.fg "38") st.bg "48"

fn add-color :: Vec Int Str Vec
  => params c prefix
  if (c < 0)
    params
  else
    conj params (prefix ++ ";5;" ++ (to-str c))

;; ── Display width ───────────────────────────────────────────────────
;;
;; Cells, not characters. A CJK ideograph occupies two columns and a
;; combining mark none; laying out by `length` drifts on both, and a
;; drifting layout corrupts every line below it.
;;
;; This is the wcwidth table, trimmed to the ranges that matter. It
;; duplicates what `term-str-width` gets from JLine, deliberately: the
;; buffer layer stays pure and testable, and an app that wants the
;; terminal's own opinion can still ask for it.
;;
;; Known gap: emoji ZWJ sequences (a flag, a family) count as their
;; parts rather than one cluster, so they over-count. Terminals
;; disagree about those anyway.

wide-ranges := #[#[4352 4447] #[8986 8987] #[9193 9196] #[9725 9726] #[9800 9811] #[11904 12871] #[12880 19903] #[19968 42191] #[43360 43388] #[44032 55203] #[63744 64255] #[65040 65049] #[65072 65135] #[65281 65376] #[65504 65510] #[127744 128591] #[128640 128764] #[129280 129750] #[131072 262141]]

zero-ranges := #[#[768 879] #[1155 1161] #[8203 8207] #[8288 8292] #[8400 8447] #[65024 65039] #[65056 65071]]

fn in-ranges? :: Int Vec Bool
  => cp ranges
  not (empty? (/? (r -> (cp >= (nth 0 r)) && (cp <= (nth 1 r))) ranges))

;; Width of a single code point: 0, 1 or 2.
pub fn char-cells :: Int Int
  => cp
  if (cp < 32)
    0
  else
    visible-cells cp

fn visible-cells :: Int Int
  => cp
  if (in-ranges? cp zero-ranges)
    0
  else
    wide-or-one cp

fn wide-or-one :: Int Int
  => cp
  if (in-ranges? cp wide-ranges)
    2
  else
    1

;; Width of a string in cells.
pub fn cell-width :: Str Int
  => s
  width-from s 0 0

fn width-from :: Str Int Int Int
  => s i acc
  if (i >= (length s))
    acc
  else
    width-step s i acc

;; Irij strings are UTF-16, so an astral code point (emoji, rare CJK)
;; arrives as a surrogate pair. Measuring the halves separately would
;; count it as two 1-cell characters instead of one 2-cell one.
fn width-step :: Str Int Int Int
  => s i acc
  hi := char-code (char-at s i)
  if ((hi >= 55296) && (hi <= 56319) && ((i + 1) < (length s)))
    width-from s (i + 2) (acc + (char-cells (astral-cp hi (char-code (char-at s (i + 1))))))
  else
    width-from s (i + 1) (acc + (char-cells hi))

fn astral-cp :: Int Int Int
  => hi lo
  65536 + ((hi - 55296) * 1024) + (lo - 56320)
