;; A small but complete uzor app: a list you can move around, tick off
;; and filter, with a status bar and a help line.
;;
;; NEEDS A TTY:
;;
;;   irij run examples/todo.irj
;;
;; j/k or ↑/↓ to move, space to toggle, a to add, f to filter,
;; ? for help, q to quit. Click a row to select it; the wheel scrolls.

use std.term {default-term}
use uzor.core :open
use uzor.style :open
use uzor.text :open
use uzor.layout :open
use uzor.box :open
use uzor.widgets :open
use uzor.event :open
use uzor.theme :open
use uzor.overlay :open
use uzor.app :open

;; One palette for the whole screen. `theme-named` takes a config
;; string, so a --theme flag would be a one-line change.
th := theme-named "dark"

;; ── Model ───────────────────────────────────────────────────────────
;;
;; One value. Every frame is a function of it, so there is no way for
;; what's drawn and what's true to drift apart.

fn initial-model :: Map
  =>
  {todos= #[{text= "write the app loop" done= true}
            {text= "draw a list" done= true}
            {text= "tick something off" done= false}
            {text= "resize the window" done= false}
            {text= "press q" done= false}]
   sel= 0
   offset= 0
   hide-done= false
   adding= false
   draft= (input "" 0)
   helping= false
   size= {cols= 80 rows= 24}
   quit= false}

;; ── Update ──────────────────────────────────────────────────────────

keys := keymap #[#["q" :quit] #["j" :down] #["down" :down] #["k" :up] #["up" :up]
                 #["space" :toggle] #["f" :filter] #["a" :add] #["?" :help]]

fn update-model :: Map Map Map
  => m ev
  if m.helping
    dismiss-help m ev
  else
    update-open m ev

;; Any key closes the help. A modal that needed a particular key to
;; dismiss it is a modal people get stuck in.
fn dismiss-help :: Map Map Map
  => m ev
  if (key-event? ev)
    {...m helping= false}
  else
    m

fn update-open :: Map Map Map
  => m ev
  if m.adding
    edit-draft m ev
  else
    browse-or-click m ev

;; The mouse is routed the same way as a key: an event in, a model out.
fn browse-or-click :: Map Map Map
  => m ev
  if (mouse-event? ev)
    click m ev
  else
    browse m ev

;; The list widget knows which item a row is — it drew them, including
;; the scroll offset. Asking it beats re-deriving that here.
fn click :: Map Map Map
  => m ev
  if (wheel-up? ev)
    {...m sel= (max 0 (m.sel - 1))}
  else
    click-down m ev

fn click-down :: Map Map Map
  => m ev
  if (wheel-down? ev)
    {...m sel= (min (m.sel + 1) (max 0 ((length (visible m)) - 1)))}
  else
    click-select m ev

fn click-select :: Map Map Map
  => m ev
  if (mouse-press? ev "left")
    select-hit m ev
  else
    m

fn select-hit :: Map Map Map
  => m ev
  pos := mouse-pos ev
  hit := list-hit (inner (list-pane m)) (list-view (@ label-of (visible m)) m.sel m.offset) (nth 0 pos) (nth 1 pos)
  if (hit == ())
    m
  else
    {...m sel= hit}

;; The list pane's rect, derived the same way the view does it — one
;; definition, so a click can never land somewhere the drawing didn't.
fn list-pane :: Map Rect
  => m
  nth 0 (split-v (rect 0 0 (get "cols" m.size) (get "rows" m.size)) #[(Fill 1) (Fixed 1) (Fixed 1)])

fn browse :: Map Map Map
  => m ev
  msg := lookup keys ev
  if (msg == ())
    note-size m ev
  else
    apply-msg m msg

;; A resize changes where the panes are, so the model keeps the size
;; the view was last drawn at — click routing reads it.
fn note-size :: Map Map Map
  => m ev
  if (resize-event? ev)
    {...m size= {cols= (get "cols" ev) rows= (get "rows" ev)}}
  else
    m

fn apply-msg :: Map _ Map
  => m msg
  match msg
    :quit => {...m quit= true}
    :down => {...m sel= (min (m.sel + 1) (max 0 ((length (visible m)) - 1)))}
    :up => {...m sel= (max 0 (m.sel - 1))}
    :toggle => toggle-selected m
    :filter => {...m hide-done= (not m.hide-done) sel= 0 offset= 0}
    :add => {...m adding= true draft= (input "" 0)}
    :help => {...m helping= true}
    _ => m

;; The filtered view is what the user is pointing at, so the selection
;; indexes into it — not into the underlying list. Toggling has to map
;; back to find the real todo.
fn visible :: Map Vec
  => m
  if m.hide-done
    /? (t -> not (get "done" t)) m.todos
  else
    m.todos

fn toggle-selected :: Map Map
  => m
  vis := visible m
  if (empty? vis)
    m
  else
    {...m todos= (@ (t -> flip-if-same t (nth m.sel vis)) m.todos)}

fn flip-if-same :: Map Map Map
  => t target
  if ((get "text" t) == (get "text" target))
    {...t done= (not (get "done" t))}
  else
    t

;; ── The add-a-todo line ─────────────────────────────────────────────

fn edit-draft :: Map Map Map
  => m ev
  if (key? ev "escape")
    {...m adding= false}
  else
    if (key? ev "enter")
      commit-draft m
    else
      {...m draft= (edit-input m.draft ev)}

fn commit-draft :: Map Map
  => m
  text := m.draft.text
  if (text == "")
    {...m adding= false}
  else
    {...m adding= false todos= (conj m.todos {text= text done= false})}

fn edit-input :: Input Map Input
  => inp ev
  if (key? ev "backspace")
    backspace inp
  else
    if (printable? ev)
      input (inp.text ++ (get "ch" ev)) (inp.cursor + 1)
    else
      inp

fn backspace :: Input Input
  => inp
  if ((length inp.text) == 0)
    inp
  else
    input (substring inp.text 0 ((length inp.text) - 1)) (max 0 (inp.cursor - 1))

;; ── View ────────────────────────────────────────────────────────────

fn view-model :: Map Map Buffer
  => m size
  screen := rect 0 0 size.cols size.rows
  rows := split-v screen #[(Fill 1) (Fixed 1) (Fixed 1)]
  listed := draw-todo-pane (buffer size.cols size.rows) (nth 0 rows) m
  statused := draw-status listed (nth 1 rows) m
  footed := draw-footer statused (nth 2 rows) m
  overlay-help footed screen m

;; The overlay goes on last, over a finished frame. There is no z-order
;; to manage because there is no scene graph to order: "on top" is just
;; "later".
fn overlay-help :: Buffer Rect Map Buffer
  => buf screen m
  if m.helping
    draw-dialog buf screen th " keys " "j/k or arrows move · space toggles · a adds · f filters · click a row to select it · the wheel scrolls · any key closes this" 44 12
  else
    buf

fn draw-todo-pane :: Buffer Rect Map Buffer
  => buf r m
  framed := draw-titled-box buf r th.chars th.border " todo "
  draw-list framed (inner r) (list-scroll (list-view (@ label-of (visible m)) m.sel m.offset) (inner r).h) th.normal th.selected

fn label-of :: Map Str
  => t
  (if (get "done" t) "[x] " else "[ ] ") ++ (get "text" t)

fn draw-status :: Buffer Rect Map Buffer
  => buf r m
  done-count := length (/? (t -> get "done" t) m.todos)
  draw-progress-labelled buf r th.bar-filled th.bar-empty th.accent done-count (max 1 (length m.todos))

fn draw-footer :: Buffer Rect Map Buffer
  => buf r m
  if m.adding
    draw-input buf r (input-scroll m.draft r.w) th.accent th.cursor
  else
    draw-label buf r th.muted (footer-text m) (Left)

fn footer-text :: Map Str
  => m
  filter-note := if (m.hide-done) "  [showing open]" else ""
  "j/k move · space toggle · a add · f filter · ? help · q quit" ++ filter-note

fn model-done? :: Map Bool
  => m
  m.quit

;; ── Entry ───────────────────────────────────────────────────────────

fn main-flow ::: Term Console
  =>
  final := run-app (app (initial-model ()) update-model view-model model-done?) {alt-screen= true mouse= true}
  open-count := length (/? (t -> not (get "done" t)) (get "todos" final))
  println ("bye — " ++ (to-str open-count) ++ " still open")

with default-term
  main-flow ()
