mod uzor.app

use std.term {Term term-enter term-leave term-size term-read term-write term-flush}
use uzor.core {Buffer buffer buf-render buf-diff}
use uzor.event {resize-event? eof-event?}

;; The app loop — the one place in uzor that touches a terminal.
;;
;; Everything below this module is a pure function of values, and this
;; is where those values meet the outside: read an event, fold it into
;; the model, draw the model, send the difference. The loop itself
;; holds no state beyond what it passes to itself.
;;
;; ── Shape ──
;;
;; An app is four functions over a model the app defines:
;;
;;   update  model event -> model
;;   view    model size  -> Buffer
;;   done?   model       -> Bool
;;
;; `done?` rather than a quit message from `update`: a message protocol
;; would have to be understood by every update fn in every app, and
;; "has this model finished" is a question the model can already answer.
;;
;; ── Testing ──
;;
;; `run-app` performs `Term` and nothing else, so a whole application
;; runs under `mock-term` with scripted keys and no terminal — the
;; frames it would have drawn are strings, and the model it ends on is
;; a value. That is the reason the layers below are pure.

pub spec App
  init :: _
  update :: Fn
  view :: Fn
  done? :: Fn

pub fn app :: _ Fn Fn Fn App
  => init update view done?
  App init update view done?

;; ── Running ─────────────────────────────────────────────────────────

;; Run until `done?` says otherwise; returns the final model.
;;
;; `opts` goes to `term-enter` — `{alt-screen= cursor= mouse=}`. The
;; terminal is restored on the way out, including when the app errors:
;; a full-screen program that dies without restoring leaves the user
;; with an unusable shell.
pub fn run-app :: App Map _ ::: Term
  => a opts
  term-enter opts
  result := try (-> run-guarded a)
  term-leave ()
  match result
    Ok model => model
    Err msg => error msg

fn run-guarded :: App _ ::: Term
  => a
  size := term-size ()
  first := render-frame a a.init size (blank-of size)
  loop-app a a.init (nth 0 first) size

;; One frame: draw the model, send only what changed, hand back the
;; buffer so the next frame has something to diff against.
;;
;; Returns #(buffer) rather than the buffer so the shape stays the same
;; if a later phase needs to report more (a cursor position, say).
fn render-frame :: App _ Map Buffer Tuple ::: Term
  => a model size prev
  buf := a.view model size
  term-write (buf-diff prev buf)
  term-flush ()
  #(buf)

fn blank-of :: Map Buffer
  => size
  buffer (get "cols" size) (get "rows" size)

;; A repaint from nothing — the first frame, and after a resize. Both
;; cases have no valid previous frame to diff against: before the first
;; there is nothing on screen, and after a resize everything below the
;; first reflowed line has moved.
fn repaint :: App _ Map Buffer ::: Term
  => a model size
  buf := a.view model size
  term-write (buf-render buf)
  term-flush ()
  buf

;; The loop. Tail-recursive, so it runs indefinitely in constant stack.
fn loop-app :: App _ Buffer Map _ ::: Term
  => a model prev size
  if (a.done? model)
    model
  else
    step-app a model prev size

fn step-app :: App _ Buffer Map _ ::: Term
  => a model prev size
  ev := term-read 50
  if (eof-event? ev)
    model
  else
    dispatch-app a model prev size ev

fn dispatch-app :: App _ Buffer Map Map _ ::: Term
  => a model prev size ev
  if (resize-event? ev)
    resize-app a model ev
  else
    advance-app a model prev size ev

;; The event still goes to `update` after a resize — an app may want to
;; know — but the frame is repainted rather than diffed, and every
;; frame after it is measured against the new size.
fn resize-app :: App _ Map _ ::: Term
  => a model ev
  size2 := {cols= (get "cols" ev) rows= (get "rows" ev)}
  model2 := a.update model ev
  loop-app a model2 (repaint a model2 size2) size2

fn advance-app :: App _ Buffer Map Map _ ::: Term
  => a model prev size ev
  model2 := a.update model ev
  if (a.done? model2)
    model2
  else
    loop-app a model2 (nth 0 (render-frame a model2 size prev)) size

;; ── Running one frame ───────────────────────────────────────────────

;; Draw a model once and return the bytes, without a loop and without
;; entering raw mode. For a one-shot report, and for testing a view in
;; isolation: no terminal is involved at all.
pub fn render-once :: App _ Map Str
  => a model size
  buf-render (a.view model size)
